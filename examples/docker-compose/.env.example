# nullops docker-compose configuration — copy to .env and edit.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# These variables are read by docker-compose.yml. The ones passed into the
# container reach the app through `nullops web --env` (NULLOPS_<FLAG>); the
# others only shape the compose file (published port, data volume).

# --- app (passed into the container) ---------------------------------------

# Serve plain http:// instead of https://. The browser channel then falls back
# to obfuscation (keystream XOR, NOT encryption). Leave false to use TLS.
NULLOPS_NO_TLS=false

# Skip the interactive --no-tls confirmation prompt. Required when NULLOPS_NO_TLS
# is true, because the container has no terminal to confirm at.
NULLOPS_YES=true

# --- compose (host side) ---------------------------------------------------

# Host interface the port is published on. 127.0.0.1 keeps it local; use
# 0.0.0.0 to expose it on every interface.
NULLOPS_BIND=127.0.0.1

# Host port to publish (the container always listens on 8181 internally).
NULLOPS_PORT=8181

# Where the served files live: a named volume (the default) or a host path,
# e.g. NULLOPS_DATA_MOUNT=./data or NULLOPS_DATA_MOUNT=/srv/share
NULLOPS_DATA_MOUNT=nullops-data

# --- build (cache busting) -------------------------------------------------

# The image downloads the *latest* release at build time, and that download
# layer is cached. Set this to a changing value (e.g. a timestamp) to force a
# fresh download on the next build, without wiping the rest of the cache:
#   NULLOPS_CACHEBUST=$(date +%s) docker compose up -d --build
# Leave it empty for normal builds (cached download).
NULLOPS_CACHEBUST=
